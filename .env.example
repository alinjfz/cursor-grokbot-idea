# Server only. Never prefix these with NEXT_PUBLIC_.

# Stripe test secret. Hosted Checkout does not need the publishable key.
STRIPE_SECRET_KEY=sk_test_

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_

# Optional. Defaults to the request host, which is enough on Vercel.
APP_URL=http://localhost:3000

# Supabase companion memory. Apply supabase/companion_profiles.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy test checkout routes use this older key if configured.
SUPABASE_SERVICE_ROLE_KEY=

# Optional model reasoning for the public companion site.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Legacy test checkout routes only.
XAI_API_KEY=
XAI_MODEL=grok-4

# Optional wider web research links. Shopify product discovery works without this.
TAVILY_API_KEY=
