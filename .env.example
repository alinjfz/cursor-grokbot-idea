# Server only. Never prefix these with NEXT_PUBLIC_.

# Stripe test secret. Hosted Checkout does not need the publishable key.
STRIPE_SECRET_KEY=sk_test_

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_

# Optional. Defaults to the request host, which is enough on Vercel.
APP_URL=http://localhost:3000

# Leave blank to run on the seed pot in src/data/seed.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank to use the handwritten fallback bundle in src/bot/decide.ts.
XAI_API_KEY=
XAI_MODEL=grok-4
